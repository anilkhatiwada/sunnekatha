DJANGO_SETTINGS_MODULE=config.settings.local
APP_VERSION=0.1.0
# LOCAL or STAGING. Production settings always display PRODUCTION.
ADMIN_ENVIRONMENT=LOCAL
HOME_PUBLIC_CACHE_TIMEOUT=300
FEATURED_CACHE_TIMEOUT=300
TAXONOMY_CACHE_TIMEOUT=900
PUBLIC_DETAIL_CACHE_TIMEOUT=300
ADMIN_DASHBOARD_CACHE_TIMEOUT=60
REDIS_URL=redis://localhost:6379/1
REDIS_RAISE_EXCEPTIONS=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=true
GOOGLE_OAUTH_CLIENT_ID=
ENFORCE_EDITORIAL_RIGHTS_READINESS=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://sunnekatha:sunnekatha@localhost:5432/sunnekatha
DATABASE_CONN_MAX_AGE=60
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_SSL_MODE=require

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CSRF_TRUSTED_ORIGINS=http://localhost:3000

DJANGO_LOG_LEVEL=INFO
DRF_ANON_THROTTLE_RATE=1000/hour
DRF_USER_THROTTLE_RATE=5000/hour
DRF_REGISTRATION_THROTTLE_RATE=3/hour
DRF_LOGIN_THROTTLE_RATE=5/minute
DRF_TOKEN_REFRESH_THROTTLE_RATE=30/minute
DRF_PASSWORD_CHANGE_THROTTLE_RATE=5/hour
DRF_UPLOAD_THROTTLE_RATE=30/hour
DRF_STREAM_THROTTLE_RATE=120/hour
DATA_UPLOAD_MAX_MEMORY_SIZE=2097152
FILE_UPLOAD_MAX_MEMORY_SIZE=2097152
DATA_UPLOAD_MAX_NUMBER_FIELDS=200
DATA_UPLOAD_MAX_NUMBER_FILES=10
ANALYTICS_MAX_RANGE_DAYS=366
ANALYTICS_PRIVACY_MIN_LISTENERS=2
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_LOG_LEVEL=INFO
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_SOFT_SHUTDOWN_TIMEOUT_SECONDS=30
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=300
CELERY_TASK_TIME_LIMIT_SECONDS=360
CELERY_VISIBILITY_TIMEOUT_SECONDS=900
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
MAX_IMAGE_UPLOAD_BYTES=10485760
MAX_AUDIO_UPLOAD_BYTES=524288000
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
AUDIO_PROCESSING_COMMAND_TIMEOUT_SECONDS=300
MAX_PERMISSION_DOCUMENT_BYTES=20971520

# Media storage. Local filesystem is used when false.
USE_S3_STORAGE=false
AWS_S3_REGION_NAME=us-east-1
AWS_S3_AUDIO_BUCKET_NAME=
AWS_S3_COVER_BUCKET_NAME=
AWS_CLOUDFRONT_DOMAIN=
AWS_QUERYSTRING_EXPIRE=900
CLOUDFRONT_MEDIA_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=
CLOUDFRONT_SIGNED_URL_EXPIRE_SECONDS=300
# Set false only during a staged backend deployment before CloudFront exists.
CLOUDFRONT_MEDIA_ENABLED=true
UPLOAD_SESSION_EXPIRY_SECONDS=900
# Optional for S3-compatible development services only.
AWS_S3_ENDPOINT_URL=
# Do not store AWS access keys here. Use an IAM task/instance role, workload
# identity, AWS_PROFILE, or another boto3 credential-provider-chain source.

# Production only
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=31536000
TRUST_X_FORWARDED_PROTO=true
USE_X_FORWARDED_HOST=false
ALLOW_INSECURE_REDIS=false
DJANGO_LOG_FORMAT=json
STATIC_MAX_AGE_SECONDS=31536000
STATIC_ROOT=./staticfiles
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT_SECONDS=60
GUNICORN_GRACEFUL_TIMEOUT_SECONDS=30
GUNICORN_KEEPALIVE_SECONDS=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_FORWARDED_ALLOW_IPS=127.0.0.1
DRF_NUM_PROXIES=1
