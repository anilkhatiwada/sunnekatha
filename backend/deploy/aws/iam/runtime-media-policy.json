{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectProductionMediaBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::sunnekatha-prod-media-533463644243-ap-south-1"
    },
    {
      "Sid": "ManageProductionMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::sunnekatha-prod-media-533463644243-ap-south-1/*"
    }
  ]
}
