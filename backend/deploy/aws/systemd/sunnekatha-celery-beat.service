[Unit]
Description=SunneKatha Celery beat scheduler
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=sunnekatha
Group=sunnekatha
WorkingDirectory=/srv/sunnekatha/current
EnvironmentFile=/etc/sunnekatha/backend.env
ExecStart=/srv/sunnekatha/venv/bin/celery -A config beat --loglevel=INFO --pidfile= --schedule=/var/lib/sunnekatha/celerybeat-schedule
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=10
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=sunnekatha
ReadWritePaths=/var/log/sunnekatha
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
